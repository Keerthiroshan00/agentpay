NODE_ENV=development
PORT=4021
FRONTEND_ORIGIN=http://localhost:5173
# Base Sepolia chain ID is 84532; x402 uses CAIP-2 network ID eip155:84532.
X402_NETWORK=eip155:84532
X402_FACILITATOR_URL=https://x402.org/facilitator
# Required to enable the optional paid sample endpoint. Use a wallet address you control.
PAY_TO=0x0000000000000000000000000000000000000000
# Optional CDP-managed x402 payer credentials. Keep these server-side only.
# The CDP client enforces per-payment, rolling spend, and network allowlists.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
CDP_WALLET_SECRET=
# Groq API key for AI task responses. Keep server-side; never use a VITE_ variable.
GROQ_API=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
# Optional URL of an external x402-protected API the agent should call.
X402_PAID_API_URL=
# Backend enforced limits (USDC decimal dollars)
MAX_PAYMENT_USDC=0.001
DAILY_BUDGET_USDC=0.01
